# Copy to .env and fill in real values. Never commit the real .env file.

# --- Backend server ---
PORT=8080

# --- Postgres (relational store: users) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=user_records
# Full DSN the backend connects with (host is the docker-compose service name when run in-network,
# "localhost" when the backend runs on the host against docker-compose ports).
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/user_records?sslmode=disable

# --- MongoDB (document store: user_logs) ---
MONGO_ROOT_USER=mongo
MONGO_ROOT_PASSWORD=mongo
MONGO_DB_NAME=user_records
MONGO_URI=mongodb://mongo:mongo@localhost:27017/?authSource=admin

# --- Auth ---
# Secret used to sign JWTs issued at login.
JWT_SECRET=change-me-to-a-long-random-string
# Server-side key for HMAC-SHA256 password hashing (see plan.md Key Decisions #1).
HMAC_SECRET=change-me-to-a-different-long-random-string

# --- Admin identity (single configured identity, not a Users row — see spec.md Assumptions) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- CORS: the frontend origin allowed to send credentialed requests ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
